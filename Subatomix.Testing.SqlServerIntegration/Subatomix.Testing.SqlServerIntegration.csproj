  <PropertyGroup>
    <Description>Subatomix SQL Server Integration Testing Helper</Description>
    <PackageDescription>Easy temporary SQL Server databases for integration testing.</PackageDescription>
    <PackageTags>$(PackageTags) integration sql server database</PackageTags>
    <TargetFrameworks>net4.8.1;net6.0;net8.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" PrivateAssets="none" />
    <PackageReference Include="Nullable"                 PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.Data"/>
    <Using Include="Microsoft.Data.SqlClient"/>
  </ItemGroup>

</Project>
